<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Born In The Mud - Project Dashboard</title>
<style>
  :root {
    --bg: #0f1115;
    --card-bg: #1a1d24;
    --gold: #d4af37;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --border: #2d3748;
  }
  
  body { 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg); 
    color: var(--text-main); 
    margin: 0; 
    padding: 20px; 
    line-height: 1.6;
  }

  h1 {
    text-align: center;
    color: var(--gold);
    font-size: 1.8em;
    margin-bottom: 5px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .subtitle {
    text-align: center;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 30px;
    font-size: 0.9em;
  }

  .section-title {
    color: var(--gold);
    border-bottom: 1px solid var(--gold);
    padding-bottom: 5px;
    margin-top: 30px;
    margin-bottom: 15px;
    font-size: 1.2em;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card {
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    text-decoration: none;
    color: var(--text-main);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.2s ease;
  }

  .card:active, .card:hover {
    background-color: #232730;
    border-color: var(--gold);
    transform: translateY(-2px);
  }

  .card-title {
    font-weight: bold;
    font-size: 1.1em;
  }

  .card-desc {
    display: block;
    font-size: 0.85em;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .badge {
    background-color: rgba(212, 175, 55, 0.2);
    color: var(--gold);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75em;
    font-weight: bold;
    white-space: nowrap;
  }

  .private-badge {
    background-color: rgba(220, 38, 38, 0.2);
    color: #f87171;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.75em;
    font-weight: bold;
    white-space: nowrap;
  }
</style>
</head>
